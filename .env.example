# Copy this file to .env and replace the placeholder values before starting Docker Compose.
POSTPILOT_DB_NAME=postpilot
POSTPILOT_DB_USER=postpilot
POSTPILOT_DB_PASSWORD=replace-with-a-local-development-password
POSTPILOT_DB_PORT=5432
POSTPILOT_API_PORT=5270

# Use this connection string when running the API directly on the host.
POSTPILOT_DATABASE_CONNECTION=Host=localhost;Port=5432;Database=postpilot;Username=postpilot;Password=replace-with-a-local-development-password
POSTPILOT_JWT_ISSUER=PostPilot
POSTPILOT_JWT_AUDIENCE=PostPilot
POSTPILOT_JWT_SIGNING_KEY=replace-with-a-unique-key-of-at-least-32-characters
POSTPILOT_JWT_EXPIRATION_MINUTES=120

# Optional integrations
POSTPILOT_STORAGE_PROVIDER=Local
POSTPILOT_CLOUDINARY_CLOUD_NAME=
POSTPILOT_CLOUDINARY_API_KEY=
POSTPILOT_CLOUDINARY_API_SECRET=
POSTPILOT_CLOUDINARY_FOLDER=postpilot
POSTPILOT_PUBLISH_PROVIDER=Mock
POSTPILOT_META_GRAPH_API_VERSION=v24.0

# OAuth connections (create an app in each platform's developer portal)
POSTPILOT_FRONTEND_ORIGIN=http://localhost:5173
POSTPILOT_OAUTH_CALLBACK_BASE_URL=http://localhost:5270
POSTPILOT_DATA_PROTECTION_KEYS_PATH=
POSTPILOT_META_CLIENT_ID=
POSTPILOT_META_CLIENT_SECRET=
POSTPILOT_X_CLIENT_ID=
POSTPILOT_X_CLIENT_SECRET=
POSTPILOT_EBAY_CLIENT_ID=
POSTPILOT_EBAY_CLIENT_SECRET=
# eBay requires the RuName value here, not the callback URL
POSTPILOT_EBAY_REDIRECT_URI=
POSTPILOT_EBAY_SANDBOX=true
POSTPILOT_ETSY_CLIENT_ID=
POSTPILOT_ETSY_SHARED_SECRET=
POSTPILOT_LAZADA_APP_KEY=
POSTPILOT_LAZADA_APP_SECRET=
POSTPILOT_SHOPEE_PARTNER_ID=
POSTPILOT_SHOPEE_PARTNER_KEY=
POSTPILOT_SHOPEE_API_BASE_URL=https://partner.shopeemobile.com
POSTPILOT_TIKTOK_SHOP_APP_KEY=
POSTPILOT_TIKTOK_SHOP_APP_SECRET=
# Copy the seller authorization URL generated by TikTok Shop Partner Center
POSTPILOT_TIKTOK_SHOP_AUTHORIZATION_URL=
